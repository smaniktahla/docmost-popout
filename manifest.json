{
  "manifest_version": 2,
  "name": "Quick Note for Docmost",
  "version": "1.0.0",
  "description": "Create a new note in your self-hosted Docmost and open it in a pop-out window. Unofficial; not affiliated with Docmost.",
  "browser_specific_settings": {
    "gecko": {
      "id": "docmost-popout@smaniktahla.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "New Docmost note (pop-out)",
    "default_icon": {
      "48": "icons/icon.svg"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "New Docmost note in pop-out window"
    }
  },
  "icons": {
    "48": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "optional_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "homepage_url": "https://github.com/smaniktahla/docmost-popout"
}